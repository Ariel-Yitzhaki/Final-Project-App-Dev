<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:padding="24dp">

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Name Your Trip"
        android:textSize="24sp"
        android:textColor="@color/text_primary"
        android:letterSpacing="0"
        android:lineHeight="32dp"
        android:fontFamily="@font/mont_heavy"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/tripNameInput"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:hint="Enter trip name"
        android:textSize="16sp"
        android:textColor="@color/button_primary"
        android:textColorHint="@color/text_hint"
        android:inputType="text"
        android:fontFamily="@font/mont_bold"
        android:background="@drawable/bg_edit_text"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toBottomOf="@id/dialogTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialogNegativeButton"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="8dp"
        android:text="Cancel"
        android:backgroundTint="@color/button_secondary"
        android:textColor="@color/button_secondary_text"
        android:textSize="14sp"
        android:textAllCaps="false"
        app:cornerRadius="8dp"
        android:letterSpacing="0"
        android:fontFamily="@font/mont_bold"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Circle"
        app:layout_constraintTop_toBottomOf="@id/tripNameInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/dialogPositiveButton"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialogPositiveButton"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="8dp"
        android:text="Start"
        android:fontFamily="@font/mont_bold"
        android:backgroundTint="@color/button_primary"
        android:textColor="@color/button_primary_text"
        android:textSize="14sp"
        app:cornerRadius="8dp"
        android:textAllCaps="false"
        android:letterSpacing="0"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Circle"
        app:layout_constraintTop_toBottomOf="@id/tripNameInput"
        app:layout_constraintStart_toEndOf="@id/dialogNegativeButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>